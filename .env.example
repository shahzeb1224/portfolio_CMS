# ─────────────────────────────────────────────────────────────
# Frontend environment configuration.
# These values are PUBLIC — they ship in the client bundle.
# NEVER put database URIs, JWT secrets, or API keys here.
# Private credentials belong on the future Express backend only.
# ─────────────────────────────────────────────────────────────

# Data source: "mock" (localStorage) or "api" (future Express backend).
VITE_DATA_SOURCE=mock

# Base URL for the future REST API. Empty while using the mock layer.
VITE_API_URL=

# Public site metadata
VITE_SITE_URL=https://example.com
